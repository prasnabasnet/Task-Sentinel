meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{base_url}}/users/auth/register/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "bruno_user",
    "email": "bruno@example.com",
    "password": "SecurePassword123!"
  }
}

script:post-response {
  if (res.status === 201 && res.body.token) {
    bru.setEnvVar("token", res.body.token);
  }
}
