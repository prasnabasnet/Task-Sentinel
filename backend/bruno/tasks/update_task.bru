meta {
  name: Update Task
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/tasks/{{task_id}}/
  body: json
  auth: none
}

headers {
  Authorization: Token {{token}}
  Content-Type: application/json
}

body:json {
  {
    "status": "IN_PROGRESS",
    "description": "Updated task description with additional checklist items."
  }
}
