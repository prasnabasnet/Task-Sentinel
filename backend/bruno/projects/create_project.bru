meta {
  name: Create Project
  type: http
  seq: 2
}

post {
  url: {{base_url}}/projects/
  body: json
  auth: none
}

headers {
  Authorization: Token {{token}}
  Content-Type: application/json
}

body:json {
  {
      "name": "ProjTest",
      "description": "Our intern project",
      "department": 1
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("project_id", String(res.body.id));
  }
}
