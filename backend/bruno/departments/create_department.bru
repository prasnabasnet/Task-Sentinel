meta {
  name: Create Department
  type: http
  seq: 2
}

post {
  url: {{base_url}}/organizations/{{organization_id}}/departments/
  body: json
  auth: none
}

headers {
  Authorization: Token {{token}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Engineering",
    "description": "Product development team",
    "head_id": 1
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("department_id", String(res.body.id));
  }
}
