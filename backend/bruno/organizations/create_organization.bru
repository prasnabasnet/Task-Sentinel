meta {
  name: Create Organization
  type: http
  seq: 2
}

post {
  url: {{base_url}}/organizations/
  body: json
  auth: none
}

headers {
  Authorization: Token {{token}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Acme Labs",
    "description": "Product and engineering organization"
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("organization_id", String(res.body.id));
  }
}
